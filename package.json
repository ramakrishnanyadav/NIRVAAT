{
  "name": "nirvaat",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@10.5.2",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "start": "tsx server.ts",
    "test": "tsx --test packages/engines/tests/engines.test.ts tests/*.test.ts tests/*.test.tsx",
    "test:contrast": "tsx scripts/check_contrast.ts",
    "test:a11y": "tsx --test tests/a11y_axe.test.tsx",
    "test:coverage": "tsx --test --experimental-test-coverage packages/engines/tests/engines.test.ts tests/*.test.ts tests/*.test.tsx",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "benchmark": "tsx scripts/benchmark_api.ts"
  },
  "dependencies": {
    "@google/genai": "^3.6.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/cookie-parser": "^1.4.10",
    "@vitejs/plugin-react": "^6.1.1",
    "axe-core": "^4.14.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "helmet": "^8.3.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.6",
    "tsx": "^4.21.0",
    "vite": "^8.3.0",
    "zod": "^4.6.7",
    "@nirvaat/contracts": "workspace:*",
    "@nirvaat/engines": "workspace:*",
    "@nirvaat/verifier": "workspace:*",
    "@nirvaat/prompts": "workspace:*"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "protobufjs"
    ]
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/express": "^4.17.21",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "jsdom": "^29.1.1",
    "supertest": "^7.3.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
